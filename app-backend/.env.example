NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=auth_db
# Set to 'true' for managed Postgres hosts (Render, Railway, Supabase, RDS, etc.)
DB_SSL=false
# Set to 'false' only if your host uses a self-signed cert
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT — must be at least 32 characters each
JWT_ACCESS_SECRET=your-super-secret-access-key-must-be-32-chars-minimum
JWT_REFRESH_SECRET=your-super-secret-refresh-key-must-be-32-chars-minimum
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Frontend URL — also the fallback for OAuth redirects and email links
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins and OAuth redirect targets.
# Include every frontend origin that will talk to this backend.
# Example: ALLOWED_ORIGINS=https://app1.example.com,https://app2.example.com
ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth
# Get these from https://console.cloud.google.com -> APIs & Services -> Credentials
# Authorized redirect URI must be: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback