NODE_ENV=production
PORT=3000

# ── Auth server's own public URL ──────────────────────────────────────────────
# Used by emailService to build verification and password-reset links.
# Must match the domain where this server is deployed.
AUTH_SERVER_URL=https://your-auth-domain.com

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_strong_password
DB_NAME=auth_db
# Set to 'true' for managed Postgres hosts (Render, Railway, Supabase, RDS, etc.)
DB_SSL=true
# Set to 'false' only if your host uses a self-signed cert
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT — must be at least 64 random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-super-secret-access-key-must-be-64-chars-minimum
JWT_REFRESH_SECRET=your-super-secret-refresh-key-must-be-64-chars-minimum
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Frontend URL — also the fallback for OAuth redirects and email links
FRONTEND_URL=https://your-frontend-domain.com
# Legacy alias kept for compatibility
CLIENT_URL=https://your-frontend-domain.com

# Comma-separated list of allowed CORS origins and OAuth redirect targets.
# Include every frontend origin that will talk to this backend.
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Logging — 'info' for production, 'debug' for development
LOG_LEVEL=info

# Google OAuth
# Get these from https://console.cloud.google.com -> APIs & Services -> Credentials
# Authorized redirect URI must match: ${AUTH_SERVER_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-auth-domain.com/api/auth/google/callback